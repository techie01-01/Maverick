# ---------------------------------------------------------------------------
# Brightloop API — copy this file to `.env` and adjust as needed.
#   cp server/.env.example server/.env
# Every value here has a sensible default, so the app runs with no .env at all.
# ---------------------------------------------------------------------------

# Port the Express API listens on
PORT=4000

# SQLite database file (created automatically)
# DB_FILE=./data/brightloop.db

# Secret used to sign JWT sessions — change this in any real deployment
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES=12h

# Base URL used to build password-reset links
APP_URL=http://localhost:5173

# Set to "production" to hide reset tokens from the forgot-password response
NODE_ENV=development

# --- Optional: real email delivery ------------------------------------------
# By default every message is captured in the in-app Email log, which is all
# that is needed to demo the flows. To send for real, wire nodemailer into
# queueMail() in server/src/lib/util.js and set these:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=secret
# SMTP_FROM=billing@brightloop.io
